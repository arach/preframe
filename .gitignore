docs/media/app/narration-full.*
public/guided-tour/narration-full.*

# Generated narration takes, one dir per TOUR_EXAMPLE x TOUR_SCRIPT pair.
# Regenerate with `bun run gen:narration:all`; the source of truth is
# src/projects/guided-tour/scripts.data.ts. Nothing links to these.
docs/media/app/*/
public/guided-tour/*/

# Guided-tour renders (regenerate with `bun run render:guided-tour`)
public/guided-tour/**/*.mp3
public/guided-tour/**/*.mp4
public/guided-tour/**/*.mov

